# Copy to .env and edit. Everything is optional; the defaults run a local demo stack.

# --- Postgres (compose only) ---
POSTGRES_PASSWORD=change-me

# --- Who you are ---
# Your own domains. Mail that lookalikes these is treated as impersonating you.
UNHOOK_ORG_DOMAINS=example-district.org
# People attackers like to pretend to be. Comma separated.
UNHOOK_PROTECTED_NAMES=Jane Smith,Alex Rivera

# --- API ---
# Leave empty only on localhost. Anything else should set a token.
UNHOOK_API_TOKEN=
UNHOOK_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Passive threat intelligence (never touches the suspect link) ---
# URLhaus and MalwareBazaar need a free abuse.ch Auth-Key.
UNHOOK_URLHAUS_AUTH_KEY=
UNHOOK_BAZAAR_AUTH_KEY=
# Optional local feed: a hostfile, a URL list or an OpenPhish-style file, mounted into the container.
UNHOOK_URLHAUS_FEED_PATH=
UNHOOK_RDAP_ENABLED=true

# --- Link sandbox (docker compose --profile sandbox up) ---
# Set this to switch on active link tracing. Leave empty to judge links without visiting them.
UNHOOK_SANDBOX_URL=
# "http" follows redirects and reads the page. "browser" also runs it in headless Chromium.
UNHOOK_SANDBOX_MODE=http

# --- Replies to the reporter ---
UNHOOK_SMTP_HOST=
UNHOOK_SMTP_PORT=587
UNHOOK_SMTP_USER=
UNHOOK_SMTP_PASSWORD=
UNHOOK_SMTP_FROM=unhook@example-district.org

# --- Reporting mailbox (docker compose --profile ingest up) ---
UNHOOK_IMAP_HOST=
UNHOOK_IMAP_USER=
UNHOOK_IMAP_PASSWORD=
UNHOOK_IMAP_FOLDER=INBOX
UNHOOK_IMAP_POLL_SECONDS=30

# --- Case notes ---
# "template" is offline and deterministic. "anthropic" drafts with an LLM, then checks every claim
# against the evidence and falls back to the template if anything is unsupported.
# For "anthropic": build with UNHOOK_BUILD_EXTRAS=llm and set ANTHROPIC_API_KEY.
UNHOOK_CASE_NOTE_PROVIDER=template
UNHOOK_LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- Reporting ---
# Minutes a human takes to triage one report by hand. Drives the "time saved" figure.
UNHOOK_MANUAL_REVIEW_MINUTES=8

# --- Workflow ---
# true: a "likely safe" verdict closes the case without an analyst seeing it.
# false: every report stays in the queue. Safer until you have evaluated Unhook on your own mail,
# because a missed phish is invisible once its case is closed.
UNHOOK_AUTO_CLOSE_SAFE=true
